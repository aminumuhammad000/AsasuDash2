# Server & Application Configuration
PORT=5001
API_PORT=4300
NODE_ENV=production
FRONTEND_URL=http://localhost:5001
JWT_SECRET=asasudash_secret_2026_super_secure_key

# Database
MONGODB_URI=mongodb://localhost:27017/asasu_portal

# Admin Email (receives notifications of new registrations, claims, disputes)
ADMIN_EMAIL=admin@asasurealty.com

# ==============================================================================
# SMTP EMAIL CONFIGURATION
# (Required for Password Reset OTP, Schedule Notifications, Claim Notifications)
# ==============================================================================

# Option 1: Hostinger Webmail / Hostinger Business Email (Recommended)
EMAIL_HOST=smtp.hostinger.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=notifications@asasurealty.com
EMAIL_PASS=YourHostingerEmailPasswordHere
EMAIL_FROM="ASASU Realty" <notifications@asasurealty.com>

# Option 2: Hostinger on Port 587 (Alternative if port 465 is blocked by ISP)
# EMAIL_HOST=smtp.hostinger.com
# EMAIL_PORT=587
# EMAIL_SECURE=false
# EMAIL_USER=notifications@asasurealty.com
# EMAIL_PASS=YourHostingerEmailPasswordHere
# EMAIL_FROM="ASASU Realty" <notifications@asasurealty.com>

# Option 3: Gmail / Google Workspace (Requires 16-character App Password)
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=465
# EMAIL_SECURE=true
# EMAIL_USER=yourcompany@gmail.com
# EMAIL_PASS=abcd efgh ijkl mnop
# EMAIL_FROM="ASASU Realty" <yourcompany@gmail.com>

# Option 4: Titan Email / Custom Webmail
# EMAIL_HOST=smtp.titan.email
# EMAIL_PORT=465
# EMAIL_SECURE=true
# EMAIL_USER=notifications@asasurealty.com
# EMAIL_PASS=YourTitanEmailPasswordHere
# EMAIL_FROM="ASASU Realty" <notifications@asasurealty.com>

# Cloudinary Storage for Evidence/Uploads (Optional)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
